    {
      "id": "det-manifest-edit",
      "why": "new AI provider added to requirements.txt",
      "files": {
        "requirements.txt": "flask\n"
      },
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "{project}/requirements.txt",
        "old_string": "flask\n",
        "new_string": "flask\ngoogle-genai>=1.0\n"
      },
      "expect": [
        "Google Gemini"
      ]
    },
    {
      "id": "det-package-json-write",
      "why": "new database driver in package.json",
      "files": {
        "package.json": "{\n  \"dependencies\": {\n    \"express\": \"^4.19.0\"\n  }\n}\n"
      },
      "tool_name": "Write",
      "tool_input": {
        "file_path": "{project}/package.json",
        "content": "{\n  \"dependencies\": {\n    \"express\": \"^4.19.0\",\n    \"mongoose\": \"^8.5.0\"\n  }\n}\n"
      },
      "expect": [
        "MongoDB"
      ]
    },
    {
      "id": "det-hardcoded-model-py",
      "why": "hardcoded model in new code",
      "tool_name": "Write",
      "tool_input": {
        "file_path": "{project}/summarize.py",
        "content": "import anthropic\n\nclient = anthropic.Anthropic()\n\ndef summarize(text):\n    return client.messages.create(model=\"claude-sonnet-4-5\", max_tokens=300,\n                                  messages=[{\"role\": \"user\", \"content\": text}])\n"
      },
      "expect": [
        "claude-sonnet-4-5"
      ]
    },
    {
      "id": "det-model-swap-edit",
      "why": "changing the model in existing code is a new model choice",
      "files": {
        "app.py": "MODEL = \"gpt-4o\"\n"
      },
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "{project}/app.py",
        "old_string": "MODEL = \"gpt-4o\"",
        "new_string": "MODEL = \"gpt-4o-mini\""
      },
      "expect": [
        "gpt-4o-mini"
      ]
    },
    {
      "id": "det-hardcoded-model-js",
      "why": "hardcoded model in JS, single quotes",
      "tool_name": "Write",
      "tool_input": {
        "file_path": "{project}/src/ai.js",
        "content": "import OpenAI from 'openai';\nconst client = new OpenAI();\nexport const ask = (q) => client.responses.create({ model: 'gpt-4.1', input: q });\n"
      },
      "expect": [
        "gpt-4.1"
