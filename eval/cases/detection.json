{
  "_comment": "PreToolUse cases. `expect` lists what NotByDefault should flag (empty = must stay silent, no interruption). `files` exist in the project before the tool call; `graph` lists decisions already recorded (status reviewed = the user already accepted it). {project} is the throwaway project dir.",
  "cases": [
    {
      "id": "det-pip-db-sdk",
      "why": "new database SDK",
      "tool_name": "Bash",
      "tool_input": {
        "command": "pip install pymongo"
      },
      "expect": [
        "MongoDB"
      ]
    },
    {
      "id": "det-npm-supabase",
      "why": "new backend-as-a-service SDK",
      "tool_name": "Bash",
      "tool_input": {
        "command": "npm i @supabase/supabase-js"
      },
      "expect": [
        "Supabase"
      ]
    },
    {
      "id": "det-pnpm-orm-and-db",
      "why": "two decisions in one install",
      "tool_name": "Bash",
      "tool_input": {
        "command": "pnpm add drizzle-orm pg"
      },
      "expect": [
        "Drizzle",
        "PostgreSQL"
      ]
    },
    {
      "id": "det-poetry-extras",
      "why": "package with extras",
      "tool_name": "Bash",
      "tool_input": {
        "command": "poetry add \"psycopg[binary]\""
      },
      "expect": [
        "PostgreSQL"
      ]
    },
    {
      "id": "det-ps-ai-provider",
